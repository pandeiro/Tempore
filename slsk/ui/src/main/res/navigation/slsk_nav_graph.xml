<?xml version="1.0" encoding="utf-8"?>
<!-- Include-able graph for the Soulseek feature (upstream nav_graph.xml includes it as
     slsk_nav_graph just before </navigation>). Ids live in this module's R namespace. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/slsk_nav_graph"
    app:startDestination="@+id/slskResultsFragment">

    <fragment
        android:id="@+id/slskResultsFragment"
        android:name="com.github.pandeiro.tempore.slsk.ui.SlskResultsFragment"
        android:label="@string/slsk_results_banner"
        tools:layout="@layout/slsk_fragment_results">
        <argument
            android:name="slsk_search_id"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="slsk_fallback_query"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true" />
        <deepLink android:id="@+id/slsk_deeplink_results" app:uri="tempore://slsk/results/{slsk_search_id}" />
        <action
            android:id="@+id/slsk_action_results_to_activity"
            app:destination="@+id/slskActivityFragment" />
    </fragment>

    <fragment
        android:id="@+id/slskActivityFragment"
        android:name="com.github.pandeiro.tempore.slsk.ui.SlskActivityFragment"
        android:label="@string/slsk_activity_title"
        tools:layout="@layout/slsk_fragment_activity" />
</navigation>
